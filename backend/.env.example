# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the Express server listens on (defaults to 5000 if unset)
PORT=5000

# MongoDB connection string
MONGO_URI=

# Secret used to sign JWT auth cookies (use a long random string)
JWT_SECRET=

# Google Gemini API key (primary AI provider + embeddings)
GEMINI_API_KEY=

# Groq API key (fallback AI provider)
GROQ_API_KEY=

# Frontend origin(s) allowed to call this API with cookies
# (comma-separated; defaults to http://localhost:5173)
# CLIENT_URL=http://localhost:5173

# Set to "production" when deploying: API error responses then omit
# internal error details (they are still logged on the server) and the
# auth cookie is marked Secure (HTTPS only)
# NODE_ENV=production
