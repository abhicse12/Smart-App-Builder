# Copy this file to .env and adjust if needed.

# Base URL of the App Builder backend (no trailing /api).
# Defaults to http://localhost:5000 when unset.
VITE_API_URL=http://localhost:5000

# Optional: OAuth Client ID from Google Cloud Console, shows the
# "Continue with Google" button (same value as the backend's GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=
